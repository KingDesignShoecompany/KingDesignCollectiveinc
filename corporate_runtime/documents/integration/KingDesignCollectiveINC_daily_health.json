{
  "name": "Umbrella Daily Health Report",
  "active": true,
  "nodes": [
    {
      "name": "Trigger",
      "type": "n8n-nodes-base.cron",
      "parameters": {
        "triggerTimes": {
          "item": [
            {
              "hour": 9,
              "minute": 0
            }
          ]
        }
      },
      "typeVersion": 1,
      "position": [
        250,
        300
      ]
    },
    {
      "name": "OpenClaw Status",
      "type": "n8n-nodes-base.http-request",
      "parameters": {
        "method": "GET",
        "url": "http://host.docker.internal:18789/api/KingDesignCollectiveINC/status"
      },
      "typeVersion": 4.1,
      "position": [
        450,
        300
      ]
    },
    {
      "name": "Send Report",
      "type": "n8n-nodes-base.telegram",
      "parameters": {
        "chatId": "telegram:-1001234567890",
        "text": "Umbrella Daily Report\\nTimestamp: {{$now}}\\nStatus: {{$json.openclaw.status || 'unknown'}}"
      },
      "typeVersion": 2,
      "position": [
        650,
        300
      ]
    }
  ],
  "connections": {
    "Trigger": {
      "main": [
        [
          "OpenClaw Status"
        ]
      ]
    },
    "OpenClaw Status": {
      "main": [
        [
          "Send Report"
        ]
      ]
    }
  }
}