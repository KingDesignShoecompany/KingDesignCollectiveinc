FROM python:3.11-slim
WORKDIR /app
RUN pip install --no-cache-dir fastapi uvicorn httpx
COPY agent_api.py .
ENV OLLAMA_BASE_URL=http://ollama:11434 \
    OLLAMA_MODEL=phi \
    OLLAMA_PROXY_URL=http://proxy:8000 \
    PORT=8001
EXPOSE 8001
HEALTHCHECK --interval=10s --timeout=5s --start-period=30s --retries=3 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8001/health'); print('ok')" || exit 1
CMD ["python", "agent_api.py"]
