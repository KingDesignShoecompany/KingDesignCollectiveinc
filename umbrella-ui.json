{
  "name": "Umbrella UI",
  "version": "1.0.0",
  "description": "Shared design system and component library for King Design Collective Inc. subsidiaries",
  "repo": "KingDesignShoecompany/KingDesignCollectiveinc",
  "assets_path": "assets/css/umbrella-ui.css",
  "scripts_path": "assets/js/umbrella-ui.js",
  "integrity": {
    "umbrella-ui.css": "sha384-placeholder",
    "umbrella-ui.js": "sha384-placeholder"
  },
  "subsidiaries": {
    "shoe-brand": {
      "body_class": "umbrella-shoe-brand",
      "color_primary": "#d4af37",
      "color_secondary": "#c0b0a0",
      "gradient": "linear-gradient(135deg, #d4af37 0%, #b8860b 100%)"
    },
    "travel-index": {
      "body_class": "umbrella-travel-index",
      "color_primary": "#4a9eff",
      "color_secondary": "#7cd67c",
      "gradient": "linear-gradient(135deg, #4a9eff 0%, #2f80e9 100%)"
    },
    "game-design": {
      "body_class": "umbrella-game-design",
      "color_primary": "#bb86ff",
      "color_secondary": "#00e5ff",
      "gradient": "linear-gradient(135deg, #bb86ff 0%, #a875f0 100%)"
    },
    "kids-channel": {
      "body_class": "umbrella-kids-channel",
      "color_primary": "#e08060",
      "color_secondary": "#8ad6ff",
      "gradient": "linear-gradient(135deg, #e08060 0%, #c75b40 100%)"
    },
    "innovation-hub": {
      "body_class": "umbrella-innovation-hub",
      "color_primary": "#00e676",
      "color_secondary": "#69ff97",
      "gradient": "linear-gradient(135deg, #00e676 0%, #00c853 100%)"
    },
    "ewaste-recycling": {
      "body_class": "umbrella-ewaste-recycling",
      "color_primary": "#ff6b35",
      "color_secondary": "#ffd23f",
      "gradient": "linear-gradient(135deg, #ff6b35 0%, #e55a2b 100%)"
    },
    "quantum-wearables": {
      "body_class": "umbrella-quantum-wearables",
      "color_primary": "#00b4d8",
      "color_secondary": "#72efdd",
      "gradient": "linear-gradient(135deg, #00b4d8 0%, #0096c7 100%)"
    }
  },
  "components": {
    "ui-btn": "Button with variants: ui-btn-primary, ui-btn-secondary, ui-btn-ghost",
    "ui-card": "Card component with header, body, footer",
    "ui-nav": "Fixed navigation bar with brand and links",
    "ui-badge": "Badge with variants: ui-badge-active, ui-badge-draft, ui-badge-complete",
    "ui-grid": "Grid layout with 2 or 3 columns",
    "ui-stat": "Statistic display with value and label"
  },
  "features": {
    "theme_toggle": "Dark/light mode toggle with OS preference detection",
    "smooth_scroll": "Anchor link smooth scrolling with nav offset",
    "scroll_animation": "Intersection observer for fade-in animations",
    "responsive_nav": "Mobile-responsive navigation"
  }
}
